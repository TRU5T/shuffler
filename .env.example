# Copy to .env and adjust. Every value can also be set as a real environment
# variable; the SSH details can additionally be edited from the UI, which
# persists them to the SQLite database and takes precedence over this file.

# --- where the disks are ---------------------------------------------------
# "ssh"   : connect to a remote Unraid host (development from another machine)
# "local" : read bind-mounted disks directly (Docker on the Unraid host)
SHUFFLER_STORAGE_BACKEND=ssh

SHUFFLER_SSH_HOST=tower.local
SHUFFLER_SSH_PORT=22
SHUFFLER_SSH_USER=root
# A key is strongly preferred; a password here is stored in plain text.
SHUFFLER_SSH_KEY_PATH=
SHUFFLER_SSH_PASSWORD=

# The directory the numbered data disks live in. /mnt/user is never touched.
SHUFFLER_MOUNT_ROOT=/mnt
SHUFFLER_DISK_PATTERN=^disk\d+$

# --- safety ---------------------------------------------------------------
# With dry_run on, the executor announces every operation but writes nothing.
# A live run always requires explicit confirmation regardless of this setting.
SHUFFLER_DRY_RUN=true

# Bytes to keep free on every disk. A queued job that would breach this is
# flagged before it can run. Default is 10 GiB.
SHUFFLER_RESERVE_BYTES=10737418240

# --- server ---------------------------------------------------------------
SHUFFLER_HOST=0.0.0.0
SHUFFLER_PORT=8756
SHUFFLER_DB_PATH=./data/shuffler.db

# --- testing only ---------------------------------------------------------
# Non-zero makes the local backend report this as each disk's capacity and
# derive usage from apparent file sizes, so the sparse fixture tree from
# scripts/make_fixtures.py behaves like a real array. Keep at 0 on hardware.
SHUFFLER_SIMULATED_DISK_CAPACITY=0
